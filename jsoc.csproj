<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>JSOC</RootNamespace>
    <AssemblyName>JSOC</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Paths -->
  <PropertyGroup>
    <!-- One place to change when SPT moves. Override on the command line with:
         dotnet build -c Release -p:SptDir=D:\SomewhereElse -->
    <SptDir Condition="'$(SptDir)' == ''">C:\SPT4.1</SptDir>
    <SptManagedDir>$(SptDir)\EscapeFromTarkov_Data\Managed</SptManagedDir>
    <SptModsDir>$(SptDir)\SPT_Runtime\user\mods\JSOC</SptModsDir>

    <!-- Absolute paths to source folders (all under Resources\) -->
    <ResourceSourceDir>$(MSBuildProjectDirectory)\Resources</ResourceSourceDir>
    <DbSourceDir>$(ResourceSourceDir)\db</DbSourceDir>
    <BundleSourceDir>$(ResourceSourceDir)\bundles</BundleSourceDir>
    <RigLayoutSourceDir>$(ResourceSourceDir)\db\CustomRigLayouts</RigLayoutSourceDir>
  </PropertyGroup>

  <!-- Collect files -->
  <ItemGroup>
    <DbFiles Include="$(DbSourceDir)\**\*.json" />
    <BundleRig Include="$(RigLayoutSourceDir)\**\*" Exclude="$(RigLayoutSourceDir)\**\*.json" />

    <BundleFiles Include="$(BundleSourceDir)\**\*" />
    <BundleManifest Include="$(MSBuildProjectDirectory)\bundles.json" />
  </ItemGroup>
  <!-- Reads version.txt, stamps it into the DLL, then bumps the patch for next time.
        Release builds only, so Debug test builds don't burn version numbers. -->
  <PropertyGroup>
    <VersionFile>$(MSBuildProjectDirectory)\version.txt</VersionFile>
  </PropertyGroup>

  <Target Name="ReadVersionFile" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <ReadLinesFromFile File="$(VersionFile)">
      <Output TaskParameter="Lines" PropertyName="_FileVersion" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <Version>$(_FileVersion.Trim())</Version>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="high" Text="Building version $(Version)" />
  </Target>

  <!-- AfterTargets="Build" only runs if the build succeeded, so a failed build doesn't bump -->
  <Target Name="BumpPatch" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_Major>$([System.Version]::Parse($(Version)).Major)</_Major>
      <_Minor>$([System.Version]::Parse($(Version)).Minor)</_Minor>
      <_Patch>$([MSBuild]::Add($([System.Version]::Parse($(Version)).Build), 1))</_Patch>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Lines="$(_Major).$(_Minor).$(_Patch)" Overwrite="true" />
  </Target>
  
  <!-- CLEAN before build -->
  <Target Name="CleanModFolder" BeforeTargets="Build">
    <Message Text=" Cleaning $(SptModsDir)" Importance="High" />
    <RemoveDir Directories="$(SptModsDir)" />
  </Target>

  <!-- Fail loudly if a source folder is missing, instead of copying nothing -->
  <Target Name="VerifyModSources" BeforeTargets="CopyAllModFiles">
    <Error Condition="!Exists('$(DbSourceDir)')" Text="DbSourceDir not found: $(DbSourceDir)" />
    <Error Condition="!Exists('$(BundleSourceDir)')" Text="BundleSourceDir not found: $(BundleSourceDir)" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\bundles.json')" Text="bundles.json not found in $(MSBuildProjectDirectory)" />
  </Target>

  <!-- COPY after build -->
  <Target Name="CopyAllModFiles" AfterTargets="Build">
    <Message Text=" Copying mod files to $(SptModsDir)" Importance="High" />
    <Message Text="   Assembly        = $(TargetFileName)" Importance="High" />
    <Message Text="   DbSourceDir     = $(DbSourceDir)" Importance="High" />
    <Message Text="   DbFiles         = @(DbFiles->Count())" Importance="High" />
    <Message Text="   BundleRig       = @(BundleRig->Count())" Importance="High" />
    <Message Text="   BundleFiles     = @(BundleFiles->Count())" Importance="High" />

    <!-- Recreate main folders -->
    <MakeDir Directories="$(SptModsDir)" />

    <!-- Copy DLL. TargetPath follows AssemblyName, so renaming the assembly
         can never break this the way $(ProjectName).dll did. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptModsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- Copy DB JSONs -->
    <Copy SourceFiles="@(DbFiles)" DestinationFiles="@(DbFiles->'$(SptModsDir)\db\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- Copy Rig Layout Bundles (non-json files DbFiles does not pick up) -->
    <Copy SourceFiles="@(BundleRig)" DestinationFiles="@(BundleRig->'$(SptModsDir)\db\CustomRigLayouts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- Copy Bundles -->
    <Copy SourceFiles="@(BundleFiles)" DestinationFiles="@(BundleFiles->'$(SptModsDir)\bundles\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- Copy bundles.json -->
    <Copy SourceFiles="@(BundleManifest)" DestinationFolder="$(SptModsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <Message Text="Copy complete!" Importance="High" />
  </Target>

  <!-- ExcludeAssets="runtime" keeps the compile-time reference but stops the
       DLL being copied into bin and shipped with the mod. -->
  <ItemGroup>
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>